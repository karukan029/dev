{
	"name": "basic",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build --mode client && vite build",
		"preview": "wrangler dev",
		"deploy": "pnpm build && wrangler deploy",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"generate:openapi": "openapi-typescript http://localhost:5173/api/openapi -o lib/openapi/schema.d.ts"
	},
	"private": true,
	"dependencies": {
		"hono": "^4.9.8",
		"honox": "^0.1.47",
		"openapi-fetch": "^0.15.0",
		"rehype-sanitize": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"unified": "^11.0.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.7",
		"@cloudflare/workers-types": "^4.20250214.0",
		"@hono/vite-build": "^1.3.0",
		"@hono/vite-dev-server": "^0.18.2",
		"@hono/vite-ssg": "^0.2.0",
		"@tailwindcss/vite": "^4.0.9",
		"@types/debug": "^4.1.12",
		"debug": "^4.4.3",
		"openapi-typescript": "^7.10.1",
		"pnpm": "^10.17.0",
		"tailwindcss": "^4.0.9",
		"vite": "^6.3.5",
		"wrangler": "^4.4.0"
	},
	"volta": {
		"node": "22.19.0"
	}
}
