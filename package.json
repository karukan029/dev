{
	"name": "@karukan029/dev",
	"version": "0.0.1-alpha.22",
	"repository": "https://github.com/karukan029/dev.git",
	"bin": {
		"dev-cli": "./bin/cli.js"
	},
	"files": [
		"app",
		"bin",
		"lib",
		"public",
		"dev.config.ts",
		"dev.config.js",
		"dev.config.d.ts",
		"vite.config.ts",
		"vite.config.js",
		"wrangler.jsonc",
		"tsconfig.json",
		".oxlintrc.json",
		".oxfmtrc.json",
		"README.md"
	],
	"type": "module",
	"exports": {
		"./config": {
			"import": "./blog.config.js",
			"types": "./blog.config.d.ts"
		}
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build --mode client && vite build",
		"build:cli": "vite build --config vite.config.cli.ts",
		"preview": "vite build && wrangler dev",
		"deploy": "vite build && wrangler deploy",
		"format": "oxfmt",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"check": "oxlint && oxfmt --check",
		"check:fix": "oxlint --fix && oxfmt",
		"check:cli": "tsc -p tsconfig.cli.json",
		"generate:openapi": "openapi-typescript http://localhost:5173/api/openapi -o lib/openapi/schema.d.ts",
		"prepack": "pnpm build:cli && vite build"
	},
	"dependencies": {
		"@hono/vite-build": "^1.3.0",
		"@hono/vite-dev-server": "^0.18.2",
		"@hono/vite-ssg": "^0.2.0",
		"@shikijs/rehype": "^3.20.0",
		"@tailwindcss/vite": "^4.0.9",
		"hono": "^4.9.8",
		"honox": "^0.1.47",
		"mdast": "^3.0.0",
		"openapi-fetch": "^0.15.0",
		"rehype-sanitize": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-frontmatter": "^5.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"shiki": "^3.20.0",
		"tailwindcss": "^4.0.9",
		"unified": "^11.0.5",
		"vite": "^6.3.5",
		"wrangler": "^4.45.3"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20250214.0",
		"@types/debug": "^4.1.12",
		"@types/mdast": "^4.0.4",
		"@types/node": "^24.10.0",
		"debug": "^4.4.3",
		"openapi-typescript": "^7.10.1",
		"oxfmt": "^0.63.0",
		"oxlint": "^1.78.0",
		"typescript": "^5.9.3"
	},
	"volta": {
		"node": "22.19.0"
	}
}
