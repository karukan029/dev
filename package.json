{
	"name": "@karukan029/dev",
	"repository": "https://github.com/karukan029/dev.git",
	"version": "0.0.1-alpha.22",
	"type": "module",
	"bin": {
		"dev-cli": "./bin/cli.js"
	},
	"exports": {
		"./config": {
			"import": "./blog.config.js",
			"types": "./blog.config.d.ts"
		}
	},
	"files": [
		"app",
		"bin",
		"lib",
		"public",
		"dev.config.ts",
		"dev.config.js",
		"dev.config.d.ts",
		"vite.config.ts",
		"vite.config.js",
		"wrangler.jsonc",
		"tsconfig.json",
		"biome.json",
		"README.md"
	],
	"scripts": {
		"dev": "vite",
		"build": "vite build --mode client && vite build",
		"preview": "vite build && wrangler dev",
		"deploy": "vite build && wrangler deploy",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"generate:openapi": "openapi-typescript http://localhost:5173/api/openapi -o lib/openapi/schema.d.ts",
		"prepublishOnly": "vite build"
	},
	"dependencies": {
		"@hono/vite-build": "^1.11.1",
		"@hono/vite-dev-server": "^0.25.3",
		"@hono/vite-ssg": "^0.3.3",
		"@shikijs/rehype": "^4.2.0",
		"@tailwindcss/vite": "^4.3.1",
		"hono": "^4.12.26",
		"honox": "^0.1.56",
		"openapi-fetch": "^0.17.0",
		"rehype-sanitize": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-frontmatter": "^5.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"shiki": "^4.2.0",
		"tailwindcss": "^4.3.1",
		"unified": "^11.0.5",
		"vite": "^6.4.3",
		"wrangler": "^4.103.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"@cloudflare/workers-types": "^4.20260621.1",
		"@types/debug": "^4.1.13",
		"@types/mdast": "^4.0.4",
		"@types/node": "^24.13.2",
		"debug": "^4.4.3",
		"openapi-typescript": "^7.13.0",
		"pnpm": "^11.8.0"
	},
	"volta": {
		"node": "24.18.0"
	}
}
