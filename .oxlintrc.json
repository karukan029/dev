{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"categories": {
		"correctness": "error",
		"suspicious": "error"
	},
	"rules": {
		"no-underscore-dangle": ["error", { "allow": ["__filename", "__dirname"] }],
		"unicorn/require-module-specifiers": "off"
	},
	"ignorePatterns": ["**/dist", "**/node_modules", "**/.wrangler"]
}
